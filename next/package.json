{
  "name": "trpc-next",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "typecheck": "pnpm -r run typecheck",
    "check": "vp check",
    "fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "example": "node examples/minimal/index.ts",
    "build": "pnpm -r run build",
    "postinstall": "vendor-src check",
    "vendor:sync": "vendor-src sync"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vendor-src": "0.15.4",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^12.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
